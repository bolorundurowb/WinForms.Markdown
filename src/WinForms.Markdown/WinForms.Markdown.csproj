<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net6.0-windows;net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>WinForms.Markdown</RootNamespace>
    <AssemblyName>WinForms.Markdown</AssemblyName>

    <!-- NuGet package metadata -->
    <PackageId>WinForms.Markdown</PackageId>
    <Version>2.0.0</Version>
    <PackageReleaseNotes>Adds lists, block quotes, code spans and blocks, horizontal rules, setext headings, escapes, entities and hard line breaks; a LinkClicked event; keyboard scrolling; and CodeBackColor, RuleColor and PreserveLineBreaks properties. Fixes double-subtracted padding, orphaned punctuation after styled text, non-wrapping headings, overflowing long words, broken underlines across spaces, and emphasis false positives such as snake_case_names. Parsing now happens once per text change and painting is clipped to the visible area. Breaking: MarkdownRenderer, TextRun and MarkdownLayout are now internal, and a newline inside a paragraph is a LineBreakInline in the AST instead of a "\n" in a TextInline.</PackageReleaseNotes>
    <Authors>Winner-Timothy Bolorunduro</Authors>
    <Company>WinForms.Markdown</Company>
    <Product>WinForms.Markdown</Product>
    <Description>A native, lightweight Markdown control for Windows Forms that renders Markdown directly with GDI+ without a web browser.</Description>
    <PackageTags>winforms;markdown;control;gdi;rendering;dotnet</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/bolorundurowb/WinForms.Markdown.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/bolorundurowb/WinForms.Markdown</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Symbols package (.snupkg) -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Reproducible symbols packages in CI -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Ship XML docs so consumers get IntelliSense. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Ship the README inside the NuGet package. -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- The layout engine and GDI helpers are internal; the tests exercise them directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="WinForms.Markdown.Tests" />
  </ItemGroup>

</Project>
